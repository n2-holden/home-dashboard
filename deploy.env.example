# Copy to deploy.env and fill in your Home Assistant SSH details.
# deploy.env is gitignored — do not commit passwords.

# Hostname or IP of your Raspberry Pi / Home Assistant
HA_HOST=homeassistant.local

# SSH user from the Terminal & SSH add-on (usually root)
HA_USER=root

# Optional: SSH port if you changed it from 22
# HA_PORT=22

# Remote folder on the HA box (served as /local/home-dashboard/)
HA_PATH=/config/www/home-dashboard

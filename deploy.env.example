# Copy to deploy.env and fill in your Home Assistant details.
# deploy.env is gitignored — do not commit passwords or tokens.

# --- Samba deploy (default: npm run deploy) ---
# UNC path to HA /config share (Settings → System → Storage → enable Samba)
HA_SHARE=\\homeassistant.local\config

# Token for the dashboard API — copy public/ha-config.example.json to ha-config.json
# at the project root (gitignored). Deploy preserves the copy on HA.

# Subpaths under HA_SHARE (usually leave as-is)
# HA_WWW=www\home-dashboard
# HA_COMPONENTS=custom_components

# --- SSH deploy (optional: npm run deploy:ssh) ---
# Requires Terminal & SSH add-on on HA and OpenSSH client on Windows.
HA_HOST=homeassistant.local
HA_USER=root
# HA_PORT=22
HA_PATH=/config/www/home-dashboard

{
  "name": "home-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:ha": "node scripts/sync-zynect-config.mjs && tsc -b && vite build --base /local/home-dashboard/",
    "preview": "vite preview",
    "deploy": "node scripts/run-deploy.mjs",
    "deploy:ssh": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy.ps1"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
